[
  {
    "peripheral": "Screen (ILI9341)",
    "bus": "16-bit parallel, two byte lanes",
    "pins": [
      {
        "pin": "PC0",
        "role": "D0",
        "note": "Low byte lane: one byte store to GPIOC->ODR (RM0390 7.4: GPIO registers accept byte accesses). PC0-PC7 only, PC8-PC15 are untouched."
      },
      {
        "pin": "PC1",
        "role": "D1"
      },
      {
        "pin": "PC2",
        "role": "D2"
      },
      {
        "pin": "PC3",
        "role": "D3"
      },
      {
        "pin": "PC4",
        "role": "D4"
      },
      {
        "pin": "PC5",
        "role": "D5"
      },
      {
        "pin": "PC6",
        "role": "D6"
      },
      {
        "pin": "PC7",
        "role": "D7"
      },
      {
        "pin": "PD8",
        "role": "D8",
        "note": "High byte lane: one byte store to the second byte of GPIOD->ODR, PD0-PD7 are untouched. Two stores per pixel fit in the ILI9341 66 ns write cycle (12 CPU cycles at 180 MHz)."
      },
      {
        "pin": "PD9",
        "role": "D9"
      },
      {
        "pin": "PD10",
        "role": "D10"
      },
      {
        "pin": "PD11",
        "role": "D11"
      },
      {
        "pin": "PD12",
        "role": "D12"
      },
      {
        "pin": "PD13",
        "role": "D13"
      },
      {
        "pin": "PD14",
        "role": "D14"
      },
      {
        "pin": "PD15",
        "role": "D15"
      },
      {
        "pin": "PD0",
        "role": "TFT_DC",
        "macro": "TFT_DC",
        "note": "Set/reset through BSRR (atomic, does not disturb the data lane)."
      },
      {
        "pin": "PD1",
        "role": "TFT_WR",
        "macro": "TFT_WR",
        "note": "Toggled per pixel through BSRR."
      },
      {
        "pin": "PB8",
        "role": "TFT_CS1 (panel 1 chip select)",
        "macro": "TFT_CS1",
        "note": "Both panels share the data bus, so each needs its own CSX."
      },
      {
        "pin": "PB9",
        "role": "TFT_CS2 (panel 2 chip select)",
        "macro": "TFT_CS2",
        "note": "Test board only (second FFC)."
      },
      {
        "pin": "PB10",
        "role": "Backlight 1 PWM (TIM2_CH3)",
        "macro": "TFT_BL",
        "note": "Gates the panel's constant-current backlight sink (op-amp + N-MOSFET, see hardware/opentone/screens.kicad_sch). TFT_RD is tied to 3V3 and TFT_RST to NRST or an RC, so they take no pins."
      },
      {
        "pin": "PA3",
        "role": "Backlight 2 PWM (TIM2_CH4)",
        "macro": "TFT_BL2",
        "note": "Test board only (second FFC). Same timer as backlight 1."
      }
    ]
  },
  {
    "peripheral": "PSRAM (APS6404L)",
    "bus": "QUADSPI bank 2",
    "pins": [
      {
        "pin": "PB2",
        "role": "PSRAM_CLK (QUADSPI_CLK)",
        "macro": "PSRAM_CLK",
        "note": "Also BOOT1: only sampled at reset when BOOT0 = 1."
      },
      {
        "pin": "PC11",
        "role": "PSRAM_CS (QUADSPI_BK2_NCS)",
        "macro": "PSRAM_CS",
        "note": "Bank 2 chip select. The bank 1 NCS is only on PB6, which I2C1 needs."
      },
      {
        "pin": "PE7",
        "role": "PSRAM_IO0 (QUADSPI_BK2_IO0)"
      },
      {
        "pin": "PE8",
        "role": "PSRAM_IO1 (QUADSPI_BK2_IO1)"
      },
      {
        "pin": "PE9",
        "role": "PSRAM_IO2 (QUADSPI_BK2_IO2)",
        "note": "IO2 only exists on PE2 (bank 1) or PE9 (bank 2) in this package."
      },
      {
        "pin": "PE10",
        "role": "PSRAM_IO3 (QUADSPI_BK2_IO3)"
      }
    ]
  },
  {
    "peripheral": "SD card",
    "bus": "SDIO 1-bit",
    "pins": [
      {
        "pin": "PC12",
        "role": "SDIO_CK"
      },
      {
        "pin": "PD2",
        "role": "SDIO_CMD",
        "note": "SDIO_CMD only exists on PD2: the reason the screen moved to byte lanes."
      },
      {
        "pin": "PC8",
        "role": "SDIO_D0",
        "note": "1-bit mode: D3 only exists on PC11 (PSRAM CS). Pull up CMD, D0 and the unused D1-D3 on the card side to the switched SD rail."
      },
      {
        "pin": "PA7",
        "role": "SD_EN (TPS22917 ON)",
        "macro": "SD_EN",
        "note": "Put PC12/PD2/PC8 in analog mode while the card is off so nothing back-powers it."
      },
      {
        "pin": "PA8",
        "role": "SD card detect",
        "macro": "SD_CD",
        "note": "EXTI8."
      }
    ]
  },
  {
    "peripheral": "VS1053",
    "bus": "SPI2",
    "pins": [
      {
        "pin": "PB12",
        "role": "MP3CS (chip select)",
        "macro": "MP3CS"
      },
      {
        "pin": "PB13",
        "role": "SPI2_SCK"
      },
      {
        "pin": "PB14",
        "role": "SPI2_MISO"
      },
      {
        "pin": "PB15",
        "role": "SPI2_MOSI"
      },
      {
        "pin": "PA4",
        "role": "MP3XDCS (data/command)",
        "macro": "MP3XDCS"
      },
      {
        "pin": "PA5",
        "role": "MP3_RESET",
        "macro": "MP3_RESET"
      },
      {
        "pin": "PE5",
        "role": "MP3DREQ",
        "macro": "MP3DREQ"
      },
      {
        "pin": "PA6",
        "role": "VS_EN (U13/U14 TPS7A20 EN, 100k pull-down)",
        "macro": "VS_EN",
        "note": "Switches the whole VS1053 (+1V8 core, +3.3VA analog and IO). Before pulling it low, put SPI2, XCS, XDCS and XRESET in analog mode (back-powering). SPI2 is on APB1: 22.5 MHz max SCK."
      }
    ]
  },
  {
    "peripheral": "MPR121",
    "bus": "I2C1",
    "pins": [
      {
        "pin": "PB6",
        "role": "SCL (I2C1_SCL)",
        "note": "Shared with the DRV2605L (0x5A) and the MAX17048 (0x36). MPR121 ADDR tied to 3.3V (0x5B)."
      },
      {
        "pin": "PB7",
        "role": "SDA (I2C1_SDA)"
      },
      {
        "pin": "PE4",
        "role": "~IRQ (active low, open-drain)",
        "macro": "MPR121_IRQ"
      }
    ]
  },
  {
    "peripheral": "DRV2605L (haptic)",
    "bus": "I2C1",
    "pins": [
      {
        "pin": "PB6",
        "role": "SCL (I2C1_SCL)"
      },
      {
        "pin": "PB7",
        "role": "SDA (I2C1_SDA)"
      },
      {
        "pin": "PB5",
        "role": "EN (hardware shutdown)",
        "macro": "DRV_EN",
        "note": "100k pull-down on the board: the DRV2605L (on VSYS) stays in shutdown while the MCU is off."
      }
    ]
  },
  {
    "peripheral": "MAX17048 (fuel gauge)",
    "bus": "I2C1",
    "pins": [
      {
        "pin": "PB6",
        "role": "SCL (I2C1_SCL)"
      },
      {
        "pin": "PB7",
        "role": "SDA (I2C1_SDA)"
      },
      {
        "pin": "PE6",
        "role": "~ALRT (low battery, open-drain)",
        "macro": "FG_ALRT"
      }
    ]
  },
  {
    "peripheral": "Charger (MCP73831)",
    "bus": "GPIO",
    "pins": [
      {
        "pin": "PB0",
        "role": "STAT (charging / done)",
        "macro": "CHG_STAT",
        "note": "EXTI0."
      }
    ]
  },
  {
    "peripheral": "DAC (CS43131)",
    "bus": "I2C1 + I2S from the VS1053",
    "pins": [
      {
        "pin": "PB6",
        "role": "SCL (I2C1_SCL)"
      },
      {
        "pin": "PB7",
        "role": "SDA (I2C1_SDA)"
      },
      {
        "pin": "PE1",
        "role": "DAC_RESET",
        "macro": "DAC_RESET",
        "note": "100k pull-down. Hold low >= 1 ms after DAC_1V8 is up, before any I2C access."
      },
      {
        "pin": "PE2",
        "role": "DAC_EN (TPS7A2018 EN + PCA9306 EN)",
        "macro": "DAC_EN",
        "note": "100k pull-down. Switches DAC_1V8 (VA/VCP/VD/VL) and disconnects the DAC from I2C1 through the PCA9306. VP stays on +3.3V."
      },
      {
        "pin": "PA10",
        "role": "DAC_INT (CS43131 INT, open drain)",
        "macro": "DAC_INT",
        "note": "EXTI10. 10k pull-up to +3.3V (VP domain). Jack 2 plug/unplug comes through here (DAC HP_DETECT), plus PLL and other DAC events."
      }
    ]
  },
  {
    "peripheral": "Headphone jacks",
    "bus": "GPIO",
    "pins": [
      {
        "pin": "PB1",
        "role": "Jack 1 detect (ADC12_IN9)",
        "macro": "HP1_DET",
        "note": "Analog read, not EXTI: 47k pull-up to +3.3VA. Plug in: ~3.3 V; no plug: the tip switch shows LEFT (~1.2 V bias). Threshold ~2.2 V, sample time 480 cycles. Only valid while VS_EN is high."
      }
    ]
  },
  {
    "peripheral": "Bluetooth (FSC-BT1035)",
    "bus": "USART2",
    "pins": [
      {
        "pin": "PD5",
        "role": "USART2_TX -> BT_RX",
        "macro": "BT_UART_TX"
      },
      {
        "pin": "PD6",
        "role": "USART2_RX <- BT_TX",
        "macro": "BT_UART_RX"
      },
      {
        "pin": "PD3",
        "role": "USART2_CTS <- BT_RTS",
        "macro": "BT_CTS",
        "note": "Hardware flow control."
      },
      {
        "pin": "PD4",
        "role": "USART2_RTS -> BT_CTS",
        "macro": "BT_RTS",
        "note": "Hardware flow control."
      },
      {
        "pin": "PD7",
        "role": "BT_EN (TPS22917 ON)",
        "macro": "BT_EN",
        "note": "The module's auto power-on circuit boots it once powered. Audio goes VS1053 I2S -> module directly, not through the STM32."
      },
      {
        "pin": "PE0",
        "role": "BT_RESET (open-drain)",
        "macro": "BT_RESET",
        "note": "Optional."
      }
    ]
  },
  {
    "peripheral": "Click-wheel buttons",
    "bus": "GPIO",
    "pins": [
      {
        "pin": "PE11",
        "role": "Center",
        "macro": "BTN_CENTER"
      },
      {
        "pin": "PE12",
        "role": "Top",
        "macro": "BTN_TOP"
      },
      {
        "pin": "PE13",
        "role": "Right",
        "macro": "BTN_RIGHT"
      },
      {
        "pin": "PE14",
        "role": "Bottom",
        "macro": "BTN_BOTTOM"
      },
      {
        "pin": "PE15",
        "role": "Left",
        "macro": "BTN_LEFT",
        "note": "PE11-PE15 are adjacent package pins 42-46, each on its own EXTI line (EXTI10-15 share one NVIC vector)."
      }
    ]
  },
  {
    "peripheral": "Status LED",
    "bus": "GPIO",
    "pins": [
      {
        "pin": "PC13",
        "role": "STATUS_LED (active low)",
        "macro": "STATUS_LED",
        "note": "Red LED D401 + R404 1k from MCU_3V3: drive PC13 low to light it (~1.4 mA). PC13 is in the backup domain: 3 mA sink max, 2 MHz, never source current. Also on J404 pin 6."
      }
    ]
  },
  {
    "peripheral": "Power / hold slider",
    "bus": "GPIO",
    "pins": [
      {
        "pin": "PE3",
        "role": "LOCK (HOLD position, active low)",
        "macro": "LOCK_SW",
        "note": "OFF / HOLD / ON slider: HOLD pulls it low, OFF pulls 3V3_EN low (no MCU pin). Going from ON to OFF passes HOLD, so save the state and finish SD writes on its falling edge. Own EXTI line, can wake the MCU."
      }
    ]
  },
  {
    "peripheral": "USB",
    "bus": "OTG_FS",
    "pins": [
      {
        "pin": "PA11",
        "role": "D- (OTG_FS_DM)"
      },
      {
        "pin": "PA12",
        "role": "D+ (OTG_FS_DP)"
      },
      {
        "pin": "PA9",
        "role": "VBUS sense (OTG_FS_VBUS)",
        "macro": "USB_VBUS",
        "note": "Also tells the firmware a charger is attached."
      }
    ]
  },
  {
    "peripheral": "Crystals",
    "bus": "Clock",
    "pins": [
      {
        "pin": "PH0",
        "role": "OSC_IN (8 MHz crystal)",
        "note": "USB needs an accurate 48 MHz clock, the HSI is not good enough."
      },
      {
        "pin": "PH1",
        "role": "OSC_OUT"
      },
      {
        "pin": "PC14",
        "role": "OSC32_IN (32.768 kHz crystal)",
        "note": "LSE: RTC and wake-up from stop mode."
      },
      {
        "pin": "PC15",
        "role": "OSC32_OUT"
      }
    ]
  },
  {
    "peripheral": "Debug",
    "bus": "SWD + UART4",
    "pins": [
      {
        "pin": "PA13",
        "role": "SWDIO"
      },
      {
        "pin": "PA14",
        "role": "SWCLK"
      },
      {
        "pin": "PB3",
        "role": "SWO (trace output)",
        "note": "Optional: printf over SWD."
      },
      {
        "pin": "PA0",
        "role": "Log UART4_TX"
      },
      {
        "pin": "PA1",
        "role": "Log UART4_RX"
      }
    ]
  }
]
