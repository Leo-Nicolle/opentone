(version 1)

# Net class clearances (Power 0.2, Analog 0.25, Touch 0.3) are for routing.
# Pads are spaced by their footprint (0.4 mm pitch QFNs, FPC connectors), so
# pad-to-pad only needs the fab minimum.
(rule "pad_to_pad"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint clearance (min 0.1mm)))

# Touch controllers (MPR121, IQS7222A) have 0.4 mm pitch pins: the Touch 0.3 mm
# (and Power/GND 0.2 mm) clearance cannot fit between them. Relax it only inside
# the fanout rule areas (courtyard + 1 mm); electrode lines keep 0.3 mm beyond.
(rule "touch_ic_fanout"
	(condition "A.intersectsArea('fanout_U501') || A.intersectsArea('fanout_U1201') || B.intersectsArea('fanout_U501') || B.intersectsArea('fanout_U1201')")
	(constraint clearance (min 0.15mm)))

# Same fanout relaxation for the other fine-pitch parts whose pins sit between
# Analog/Touch nets: the DAC (U701, 0.4 mm QFN, GND pins next to the EP) and the
# click wheel FPC (J501, 0.5 mm, GND pin between electrode pins), and the audio
# codec VS1 / headphone amp U15 (0.5 mm pins carrying Analog nets).
(rule "fine_pitch_fanout"
	(condition "A.intersectsArea('fanout_U701') || A.intersectsArea('fanout_J501') || A.intersectsArea('fanout_VS1') || A.intersectsArea('fanout_U15') || B.intersectsArea('fanout_U701') || B.intersectsArea('fanout_J501') || B.intersectsArea('fanout_VS1') || B.intersectsArea('fanout_U15')")
	(constraint clearance (min 0.15mm)))
