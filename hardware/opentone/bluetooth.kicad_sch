	(text "I2S from the VS1053 (module = I2S slave). 0R: unfit to free the bus for the DAC.\nPCM_MCLK_OUT (pin 9) is an output and not needed: left open."
		(exclude_from_sim no)
		(at 274.32 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "099e2d23-8fd7-41b1-a21d-a26a4b729fa2")
	)
	(text "VIN cap   CT (slew)   EN pull-up  QOD (DNP if bypassed)"
		(exclude_from_sim no)
		(at 180.34 215.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "426a6177-0223-456e-8f44-233a8ecc7ec8")
	)
	(text "When BT_3V3 rises, Q101 holds SYS_CTRL low ~100 ms,\nthen releases it -> the module boots."
		(exclude_from_sim no)
		(at 287.02 186.69 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "4af9dd2b-6765-4a69-82ce-501bc78fc817")
	)
	(text "MCU (STM32F446VET6), see docs/public/pinout/LQFP100/mapping.json:\n- BT_RX  <- PD5 USART2_TX      - BT_TX  -> PD6 USART2_RX\n- BT_CTS <- PD4 USART2_RTS     - BT_RTS -> PD3 USART2_CTS\n- BT_EN  <- PD7 (high = BT powered, pulled up)\n- BT_RESET <- PE0, open-drain (RESET# has an internal pull-up)\nBefore pulling BT_EN low, put USART2, BT_RESET and the I2S lines in analog mode (back-powering)."
		(exclude_from_sim no)
		(at 35.56 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "51e1a344-7a18-43c5-bd7d-1e612316ac71")
	)
	(text "Supply: +3.3V -> JP5 (cut to measure the BT drain) -> TPS22917"
		(exclude_from_sim no)
		(at 35.56 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6fc54cb6-4961-48fa-8c71-a695a7fc7867")
	)
	(text "Auto power-on (datasheet ref. circuit)"
		(exclude_from_sim no)
		(at 287.02 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "735ad4bb-8efa-49d9-9cbf-518090584347")
	)
	(text "Status LEDs (LED pads are open-drain)"
		(exclude_from_sim no)
		(at 301.244 108.966 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8f46db5c-d997-4027-ad40-1dca52ae1bae")
	)
	(text "Power: +3.3V -> JP5 -> TPS22917 load switch (BT_EN) -> VBAT_IN and VDD_IO (module accepts 3.0-4.2 V, all I/O at 3.3 V logic).\nSwitching BT_3V3 on boots the module (auto power-on circuit on SYS_CTRL). No USB: VCHG, VCHG_SENSE and USB_D+/D- are left open."
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b98634f8-dd9a-42ef-9767-91bd7ea3fc92")
	)
	(text "Bypass: close JP101 and leave the 0R (QOD) unfitted,\nor QOD would discharge the 3V3 rail while the switch is off."
		(exclude_from_sim no)
		(at 35.56 113.03 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "c2670401-f069-441c-b8e9-066d0730589e")
	)
