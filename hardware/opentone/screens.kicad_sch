	)
	(text "IPS panel: datasheets/display/NHD-2.4-240320AF-CSXP.pdf. LED 80-200 mA, Vf 2.7-3.4 V: at 82 mA from +3.3V the sink keeps ~0.2 V. Use VSYS if the current drops."
		(exclude_from_sim no)
		(at 208.28 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
